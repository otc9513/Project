# قاعدة البيانات
DATABASE_URL="postgresql://user:password@localhost:5432/ampere"

# Auth.js
AUTH_SECRET="" # openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (المصدر الوحيد المسموح للمصادقة)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# التخزين (S3-compatible: Cloudflare R2 / MinIO / AWS S3) - يُستخدم لأصول
# البراندنغ (المرحلة 8) وأي ملفات مرفوعة أخرى مستقبلاً
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="auto"
# اختياري: إن كان الرابط العام مختلفًا عن STORAGE_ENDPOINT (مثال: نطاق
# مخصَّص أمام R2/CDN). إن تُرك فارغًا، يُستخدم STORAGE_ENDPOINT نفسه.
STORAGE_PUBLIC_URL=""

# Push Notifications (Web Push VAPID keys)
# وَلِّدها محليًا بالأمر: npx web-push generate-vapid-keys
# المفتاح العام يحمل بادئة NEXT_PUBLIC_ عمدًا لأنه يُستخدم في متصفح
# المستخدم (PushManager.subscribe) خلافًا للمفتاح الخاص الذي يبقى على
# الخادم فقط ولا يجوز أبدًا كشفه للعميل.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@ampere.app"

# المرحلة 8: سر التحقق من مسار Vercel Cron (/api/cron/billing) - يُولَّد
# بنفس أمر AUTH_SECRET (openssl rand -base64 32) ويُضاف كمتغيّر بيئة على
# Vercel فقط (Vercel يرسله تلقائيًا كترويسة Authorization لاستدعاءات
# Cron المجدوَلة - راجع vercel.json). لا يُكشَف أبدًا للمتصفح.
CRON_SECRET=""

# المرحلة 9: مراقبة الأخطاء المركزية (Sentry). NEXT_PUBLIC_SENTRY_DSN
# مُعرَّض عمدًا للمتصفح (بادئة NEXT_PUBLIC_) - هذا هو التصميم الرسمي
# لـ DSN في Sentry، ليس سرًا حساسًا (لا يسمح إلا بإرسال أحداث، لا قراءتها).
# SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN اختيارية: تُستخدَم فقط وقت
# البناء (next.config.js) لرفع خرائط المصدر (Source Maps) - اتركها
# فارغة محليًا، اضبطها في أسرار CI/Vercel فقط لبيئة الإنتاج.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# المرحلة 10: بوابة الدفع الإلكتروني. "stub" (الافتراضي) يعني معطَّلة
# فعليًا بأمان - لا مزوّد حقيقي مُدمَج بعد (راجع
# src/features/platform-billing/payment/stub-provider.ts للتفاصيل
# وخطوات التفعيل الفعلية لاحقًا). لا تُغيّرها لأي قيمة أخرى قبل تطبيق
# تلك الخطوات فعليًا - النظام سيرفض أي قيمة غير مسجَّلة ويسقط لـ stub تلقائيًا.
PAYMENT_GATEWAY_PROVIDER="stub"

# المرحلة 11: مفتاح تشفير أسرار 2FA عند الراحة (AES-256-GCM) - 32 بايت
# بترميز base64. وّلّده عبر: openssl rand -base64 32
# لا تُغيّره بعد أول استخدام فعلي (سيُفقَد الوصول لكل أسرار TOTP
# المُشفَّرة سابقًا ويُضطر كل عضو فريق منصة لإعادة تسجيل 2FA من الصفر).
MFA_ENCRYPTION_KEY=""

# المرحلة 12: محدِّد المعدَّل الموزَّع (Redis عبر Upstash REST). اختياري
# تمامًا - إن تُركا فارغين، يعمل النظام بمحدِّد في الذاكرة المحلية تلقائيًا
# (كافٍ لعملية واحدة فقط - راجع src/lib/security/rate-limit.ts). أضفهما
# فقط عند النشر على أكثر من عملية/Pod متوازية.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# بذرة أول Super Admin (يُستهلَك مرة واحدة فقط عبر prisma/seed.ts - راجع
# التعليق هناك). اترك فارغًا بعد أول تشغيل ناجح.
SEED_SUPER_ADMIN_EMAIL=""
