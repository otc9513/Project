// ============================================================================
// Ampere (أمبير) - Generator Management OS
// Prisma Schema - المرجع الوحيد لبنية قاعدة البيانات
// ============================================================================
// ملاحظات تصميم:
// - عزل المستأجرين (Multi-Tenant Isolation) يتم عبر tenantId في كل جدول عملياتي.
//   كل استعلام في طبقة الـ repository يجب أن يمرّ عبر withTenant() (راجع src/lib/tenant).
// - الحقول المالية (Decimal) تُخزَّن كـ Decimal وليس Float لتفادي أخطاء التقريب.
// - كل جدول يحتفظ بـ createdAt/updatedAt، والجداول المالية تحتفظ بـ createdById لتتبّع الفاعل.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// المنصّة والاشتراكات (SaaS Plans)
// ----------------------------------------------------------------------------

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique // Basic / Professional / Enterprise
  nameAr      String
  priceMonthly Decimal @db.Decimal(10, 2)
  // المرحلة 8: سعر سنوي اختياري (خصم عادةً) + مدة تجربة مجانية بالأيام.
  // اختياري لأن هذا الحقل أُضيف بعد إطلاق الخطط الحالية (seed.ts) وبعضها
  // (مثال: Basic بسعر 0) لا يحتاج فترة تجربة أو سعرًا سنويًا مختلفًا.
  priceYearly Decimal? @db.Decimal(10, 2)
  trialDays   Int      @default(0)
  sortOrder   Int      @default(0)
  maxGenerators Int?
  maxSubscribers Int?
  maxEmployees  Int?
  features    Json     // { billing: true, reports: true, ai: false, ... }
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants       Tenant[]
  saasInvoices  SaasInvoice[]

  @@index([sortOrder])
}

model Tenant {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  // معلومات تواصل تجارية للمستأجر (تُعرض في لوحة Super Admin، منفصلة عن
  // بريد/اسم المستخدم OWNER لأن الشركة قد تُغيّر مالكها لاحقًا بينما يبقى
  // رقم التواصل التجاري للمنصة كما هو).
  contactPhone String?
  planId      String
  plan        Plan      @relation(fields: [planId], references: [id])
  // تجاوز ميزات محددة لهذا المستأجر بعينه (Feature Override)
  featureOverrides Json  @default("{}")
  status      TenantStatus @default(TRIAL)
  // دورة حياة الاشتراك (المرحلة 8): تجربة مجانية تنتهي بتاريخ محدد، ثم
  // اشتراك مدفوع له تاريخ تجديد. كلاهما اختياري لأن مستأجرين قدامى
  // (أُنشئوا في المراحل 1-7 قبل وجود هذا المفهوم) قد لا يملكونهما.
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  // المرحلة 8 (فوترة تلقائية): دورة الفوترة المعتمَدة لتجديد هذا المستأجر
  // تلقائيًا (شهري/سنوي). تُضبَط عند أول توليد فاتورة SaaS (يدويًا أو
  // تلقائيًا) - تبقى فارغة لمستأجري الخطة المجانية (priceMonthly=0) الذين
  // لا حاجة لتوليد فواتير تجديد لهم أصلاً، والـ Cron يتجاهلهم بأمان.
  billingCycle       BillingCycle?
  suspendedAt        DateTime?
  suspensionReason   String?
  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships   Membership[]
  generators    Generator[]
  subscribers   Subscriber[]
  ampPlans      AmperePlan[]
  invoices      Invoice[]
  payments      Payment[]
  expenses      Expense[]
  fuelPurchases FuelPurchase[]
  fuelUsages    FuelUsage[]
  maintenances  MaintenanceRecord[]
  faults        Fault[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  auditLogs     AuditLog[]
  saasInvoices  SaasInvoice[]

  @@index([slug])
  @@index([status])
}

// دورة حياة الاشتراك الكاملة وفق مواصفات المرحلة 8 (Super Admin):
// TRIAL: فترة تجربة جديدة. ACTIVE: اشتراك مدفوع سارٍ. EXPIRED: انتهت
// التجربة/الاشتراك دون تجديد (البيانات تبقى محفوظة، الميزات المدفوعة تُعطَّل
// عبر requireTenantContext + isFeatureEnabled، وليس بحذف أي شيء).
// SUSPENDED: تعليق يدوي من Super Admin (مثال: نزاع دفع). CANCELLED: إلغاء
// نهائي من صاحب الحساب أو الإدارة.
enum TenantStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

// ----------------------------------------------------------------------------
// المستخدمون والمصادقة (Auth.js / Google OAuth فقط)
// ----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // قرار هندسي (المرحلة 8): استُبدل `isSuperAdmin Boolean` (لم يكن مستخدَمًا
  // بعد خارج auth.config.ts) بحقل دور اختياري بثلاث قيم، لأن مواصفات
  // "Admin Users" (القسم 8) تتطلب صراحةً Super Admin/Support Admin/Finance
  // Admin كأدوار منفصلة الصلاحيات وليس فقط تفعيل/تعطيل ثنائي. null = مستخدم
  // عادي (صاحب مولد/موظف) بلا أي صلاحية على لوحة المنصة.
  platformRole  PlatformRole?
  // المرحلة 11 (2FA لفريق المنصة): مُطبَّقة على أي مستخدم يملك platformRole
  // (أي دور من الثلاثة، وليس SUPER_ADMIN حصرًا) - كلها تصل للوحة تحكم
  // حسّاسة (فوترة، بيانات مستأجرين، تعليق حسابات) وليس فقط SUPER_ADMIN.
  // السر نفسه مُشفَّر دائمًا (راجع src/lib/security/mfa-crypto.ts) - لا
  // نص صريح مخزَّن أبدًا، مطابقةً لمتطلب "no plaintext secrets" صراحةً.
  mfaEnabled            Boolean  @default(false)
  mfaSecretEncrypted    String?
  // أكواد استرداد لمرة واحدة (Recovery Codes) - مُخزَّنة كـ hash فقط
  // (SHA-256 عبر crypto.createHash القياسية - مقبول هنا لأنها أكواد
  // عشوائية عالية الإنتروبيا وليست كلمات مرور بشرية قابلة للتخمين، على
  // عكس bcrypt/argon2 المخصَّصين لكلمات مرور منخفضة الإنتروبيا).
  mfaRecoveryCodesHashed String[] @default([])
  mfaEnrolledAt         DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships  Membership[]
  auditLogs    AuditLog[]
  faultUpdates FaultUpdate[]
  collectedPayments Payment[]
  pushSubscriptions PushSubscription[]
  recordedSaasPayments SaasPayment[]

  @@index([platformRole])
}

// أدوار فريق تشغيل المنصة نفسها (Super Admin) - منفصلة تمامًا عن أدوار
// المستأجر (Role: OWNER/ADMIN/ACCOUNTANT/...) التي تخص موظفي كل شركة مولدات.
enum PlatformRole {
  SUPER_ADMIN    // تحكم كامل: كل شيء بما فيه الفوترة وحذف المستأجرين وإدارة فريق المنصة
  SUPPORT_ADMIN  // يساعد المستأجرين (عرض/تعليق/تفعيل) لكن لا يلمس الفوترة أو حذف الحسابات
  FINANCE_ADMIN  // يدير فوترة SaaS والدفعات فقط، دون صلاحية تعليق/حذف حسابات
}

// دعوة مسبقة لعضوية فريق المنصة: بما أن تسجيل الدخول عبر Google OAuth فقط
// (لا يوجد "إنشاء مستخدم" مباشر)، يُنشئ Super Admin دعوة بالبريد الإلكتروني
// ومتى سجّل ذلك البريد دخوله لأول مرة يُمنح platformRole المحدد تلقائيًا
// (راجع src/lib/tenant/onboarding.ts → consumePlatformAdminInvite).
model PlatformAdminInvite {
  id          String       @id @default(cuid())
  email       String       @unique
  role        PlatformRole
  invitedById String
  consumedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([email])
}

// جداول قياسية يتطلبها Auth.js (NextAuth) مع مزوّد Google فقط
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  // المرحلة 11: يُضبَط فقط بعد اجتياز تحدّي 2FA بنجاح لهذه الجلسة تحديدًا
  // (وليس علمًا دائمًا على المستخدم) - يعني أن كل تسجيل دخول جديد (جلسة
  // جديدة) يتطلّب اجتياز 2FA من جديد، حتى لو كان المستخدم قد فعّلها سابقًا
  // في جلسة/جهاز آخر. NULL لأي مستخدم لم يُفعِّل 2FA أصلاً (لا يُفحَص
  // الحقل إطلاقًا لحسابات mfaEnabled=false).
  mfaVerifiedAt DateTime?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ربط مستخدم بمستأجر مع دور محدد (مستخدم واحد قد ينتمي لأكثر من مستأجر لاحقًا)
model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

enum Role {
  OWNER
  ADMIN
  ACCOUNTANT
  COLLECTOR
  TECHNICIAN
}

// ----------------------------------------------------------------------------
// المولدات
// ----------------------------------------------------------------------------

model Generator {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  location      String?
  capacityKva   Decimal? @db.Decimal(10, 2)
  fuelType      FuelType @default(DIESEL)
  status        GeneratorStatus @default(OPERATIONAL)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  fuelPurchases FuelPurchase[]
  fuelUsages    FuelUsage[]
  maintenances  MaintenanceRecord[]
  faults        Fault[]

  @@index([tenantId])
}

enum FuelType {
  DIESEL
  GASOLINE
  GAS
}

enum GeneratorStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  OFFLINE
}

// ----------------------------------------------------------------------------
// المشتركون والاشتراكات
// ----------------------------------------------------------------------------

model Subscriber {
  id               String   @id @default(cuid())
  tenantId         String
  fullName         String
  phone            String
  area             String?
  street           String?
  houseNumber      String?
  subscriptionNo   String?
  notes            String?  @db.Text
  status           SubscriberStatus @default(ACTIVE)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  invoices      Invoice[]
  payments      Payment[]

  @@index([tenantId])
  @@index([tenantId, phone])
}

enum SubscriberStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  DEBT
}

// خطط الأمبير المتاحة لدى المستأجر (5A / 10A / 15A / مخصص)
model AmperePlan {
  id            String  @id @default(cuid())
  tenantId      String
  ampere        Decimal @db.Decimal(6, 2)
  defaultPrice  Decimal @db.Decimal(10, 2)
  isCustom      Boolean @default(false)
  isActive      Boolean @default(true)

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([tenantId])
}

// الاشتراك الفعلي لمشترك بمولد معيّن، مع سجل تاريخي للتغييرات
model Subscription {
  id            String   @id @default(cuid())
  subscriberId  String
  generatorId   String
  amperePlanId  String
  monthlyPrice  Decimal  @db.Decimal(10, 2)
  startDate     DateTime
  status        SubscriberStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriber Subscriber  @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  generator  Generator   @relation(fields: [generatorId], references: [id])
  amperePlan AmperePlan  @relation(fields: [amperePlanId], references: [id])
  history    SubscriptionHistory[]
  invoices   Invoice[]

  @@index([subscriberId])
  @@index([generatorId])
}

// سجل كل تغيير على الاشتراك (سعر/أمبير) مع مَن قام به ومتى
model SubscriptionHistory {
  id             String   @id @default(cuid())
  subscriptionId String
  changedById    String
  previousAmpere Decimal? @db.Decimal(6, 2)
  newAmpere      Decimal? @db.Decimal(6, 2)
  previousPrice  Decimal? @db.Decimal(10, 2)
  newPrice       Decimal? @db.Decimal(10, 2)
  changedAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

// ----------------------------------------------------------------------------
// الفوترة والدفعات
// ----------------------------------------------------------------------------

model Invoice {
  id             String   @id @default(cuid())
  tenantId       String
  subscriberId   String
  subscriptionId String?
  month          Int      // 1-12
  year           Int
  amount         Decimal  @db.Decimal(10, 2)
  paidAmount     Decimal  @default(0) @db.Decimal(10, 2)
  dueDate        DateTime
  status         InvoiceStatus @default(UNPAID)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriber   Subscriber    @relation(fields: [subscriberId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  payments     Payment[]

  @@unique([subscriberId, month, year])
  @@index([tenantId, status])
}

enum InvoiceStatus {
  PAID
  UNPAID
  PARTIAL
  CANCELLED
}

model Payment {
  id            String   @id @default(cuid())
  tenantId      String
  invoiceId     String
  subscriberId  String
  collectedById String
  amount        Decimal  @db.Decimal(10, 2)
  note          String?
  paidAt        DateTime @default(now())
  createdAt     DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice    Invoice    @relation(fields: [invoiceId], references: [id])
  subscriber Subscriber @relation(fields: [subscriberId], references: [id])
  // علاقة صريحة إلى User لعرض اسم المحصّل في تقرير التحصيل (المرحلة 6) وسجلات
  // الدفعات، بنفس القرار الهندسي المتّبع سابقًا في FaultUpdate.user: كانت
  // العلاقة مفقودة رغم وجود collectedById كحقل خام غير مرتبط.
  collector  User       @relation(fields: [collectedById], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@index([collectedById])
}

// ----------------------------------------------------------------------------
// المصاريف والوقود
// ----------------------------------------------------------------------------

model Expense {
  id          String   @id @default(cuid())
  tenantId    String
  category    ExpenseCategory
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime
  description String?  @db.Text
  attachmentUrl String?
  createdById String
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category])
}

enum ExpenseCategory {
  FUEL
  MAINTENANCE
  SPARE_PARTS
  SALARIES
  OTHER
}

model FuelPurchase {
  id          String   @id @default(cuid())
  tenantId    String
  generatorId String
  quantityLiters Decimal @db.Decimal(10, 2)
  price       Decimal  @db.Decimal(10, 2)
  supplier    String?
  date        DateTime
  createdAt   DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  generator Generator @relation(fields: [generatorId], references: [id])

  @@index([tenantId])
}

model FuelUsage {
  id             String   @id @default(cuid())
  tenantId       String
  generatorId    String
  quantityLiters Decimal  @db.Decimal(10, 2)
  date           DateTime
  notes          String?
  createdAt      DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  generator Generator @relation(fields: [generatorId], references: [id])

  @@index([tenantId])
}

// ----------------------------------------------------------------------------
// الصيانة والأعطال
// ----------------------------------------------------------------------------

model MaintenanceRecord {
  id          String   @id @default(cuid())
  tenantId    String
  generatorId String
  type        String
  description String?  @db.Text
  cost        Decimal  @db.Decimal(10, 2)
  date        DateTime
  technicianId String?
  nextDueDate DateTime?
  createdAt   DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  generator Generator @relation(fields: [generatorId], references: [id])

  @@index([tenantId])
}

model Fault {
  id           String   @id @default(cuid())
  tenantId     String
  generatorId  String
  title        String
  description  String?  @db.Text
  priority     FaultPriority @default(MEDIUM)
  status       FaultStatus   @default(NEW)
  assignedToId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  generator Generator @relation(fields: [generatorId], references: [id])
  updates   FaultUpdate[]

  @@index([tenantId, status])
}

enum FaultPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FaultStatus {
  NEW
  IN_PROGRESS
  COMPLETED
}

model FaultUpdate {
  id        String   @id @default(cuid())
  faultId   String
  userId    String
  note      String   @db.Text
  createdAt DateTime @default(now())

  fault Fault @relation(fields: [faultId], references: [id], onDelete: Cascade)
  // علاقة صريحة إلى User لعرض "مَن أضاف هذا التحديث" في سجل العطل (كانت مفقودة،
  // أُضيفت لأن مواصفات وحدة الأعطال/سجل التدقيق تتطلب معرفة الفاعل صراحةً وليس مجرد معرّفه).
  user User @relation(fields: [userId], references: [id])

  @@index([faultId])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// الإشعارات والتدقيق
// ----------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?  // null = لكل مستخدمي المستأجر
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

// اشتراك دفع المتصفح/الجهاز (Web Push) - المرحلة 7. منفصل تمامًا عن
// PushNotificationCampaign (الذي يمثّل "حملة" يرسلها Super Admin) لأن هذا
// الجدول يمثّل "من نستطيع الوصول إليه فعليًا الآن" (Endpoint + مفاتيح تشفير
// لكل جهاز/متصفح مسجَّل)، وهو المصدر الفعلي الذي تُفلتَر منه جماهير الحملات.
model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  endpoint  String   @db.Text
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([tenantId])
}

// سجل تدقيق شامل: مَن فعل ماذا ومتى (يشمل كل العمليات الحساسة)
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String
  action     String   // e.g. "subscriber.price_changed"
  entityType String
  entityId   String
  changes    Json?    // { before: {...}, after: {...} }
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
}

// ----------------------------------------------------------------------------
// فوترة SaaS (Super Admin فقط) - اشتراك المستأجر بالمنصة نفسها
// ----------------------------------------------------------------------------
// تنبيه هندسي مهم: هذان الجدولان منفصلان تمامًا عن Invoice/Payment أعلاه.
// Invoice/Payment يخصّان "مشترك يدفع لصاحب المولد" (فوترة تشغيلية داخل
// مساحة المستأجر). SaasInvoice/SaasPayment يخصّان "صاحب المولد (المستأجر)
// يدفع لمنصة أمبير نفسها" اشتراكه الشهري/السنوي. خلط الجدولين كان سيُنتج
// تسريب بيانات خطير بين طبقتين مختلفتين تمامًا من الفوترة.

model SaasInvoice {
  id          String   @id @default(cuid())
  tenantId    String
  planId      String
  amount      Decimal  @db.Decimal(10, 2)
  paidAmount  Decimal  @default(0) @db.Decimal(10, 2)
  billingCycle BillingCycle
  periodStart DateTime
  periodEnd   DateTime
  dueDate     DateTime
  status      SaasInvoiceStatus @default(UNPAID)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan          @relation(fields: [planId], references: [id])
  payments SaasPayment[]

  // ضمان عدم التكرار على مستوى قاعدة البيانات (وليس فقط منطق التطبيق):
  // لا يمكن أبدًا وجود فاتورتين لنفس المستأجر لنفس فترة الفوترة، حتى لو
  // استُدعيت مهمة التوليد التلقائي مرتين بالتزامن (Race Condition) أو
  // أُعيد تشغيل الـ Cron. هذا هو أساس متطلب "Idempotency" في المرحلة 8.
  @@unique([tenantId, periodStart, periodEnd])
  @@index([tenantId, status])
  @@index([dueDate])
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SaasInvoiceStatus {
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

model SaasPayment {
  id             String   @id @default(cuid())
  saasInvoiceId  String
  amount         Decimal  @db.Decimal(10, 2)
  method         String   @default("MANUAL") // MANUAL لحين إضافة بوابة دفع إلكترونية
  note           String?
  // Nullable: دفعة webhook من بوابة دفع إلكترونية لا يُنشئها موظف بشري -
  // كانت هذه العلاقة إلزامية سابقًا لأن كل الدفعات كانت يدوية حصرًا.
  recordedById   String?
  paidAt         DateTime @default(now())
  createdAt      DateTime @default(now())

  // المرحلة 10 (بوابة دفع): معرّف العملية لدى مزوّد الدفع الخارجي (مثال:
  // Stripe PaymentIntent ID). @unique هو أساس idempotency الـ webhook -
  // إشعار webhook مكرَّر لنفس العملية (شائع جدًا - كل مزوّدي الدفع يعيدون
  // إرسال الإشعار عند أي شك في الاستلام) يرتطم بهذا القيد بدل تسجيل
  // الدفعة مرتين. NULL لكل الدفعات اليدوية القديمة/الحالية (method=MANUAL).
  providerRef    String?  @unique

  saasInvoice SaasInvoice @relation(fields: [saasInvoiceId], references: [id], onDelete: Cascade)
  recordedBy  User?       @relation(fields: [recordedById], references: [id])

  @@index([saasInvoiceId])
}

// المرحلة 8: سجل تنفيذ مهام الصيانة الدورية (Cron). منفصل عمدًا عن
// AuditLog لأن AuditLog يفترض فاعلًا بشريًا (userId إلزامي، FK لجدول
// User) بينما هذه عملية نظامية بلا مستخدم، وتحتاج حقولًا لا معنى لها في
// سجل تدقيق عادي (مدة التنفيذ، عدّادات مجمَّعة لكل نوع عملية).
model CronExecutionLog {
  id                String   @id @default(cuid())
  jobName           String   // مثال: "billing-lifecycle"
  startedAt         DateTime
  finishedAt        DateTime?
  status            CronExecutionStatus @default(RUNNING)
  tenantsProcessed  Int      @default(0)
  trialsExpired     Int      @default(0)
  subscriptionsExpired Int   @default(0)
  invoicesGenerated Int      @default(0)
  invoicesMarkedOverdue Int  @default(0)
  errors            Json?    // [{ tenantId, message }, ...]
  createdAt         DateTime @default(now())

  @@index([jobName, startedAt])
}

enum CronExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
}

// ----------------------------------------------------------------------------
// إدارة المنصة (Super Admin فقط) - البراندنغ والإعلانات
// ----------------------------------------------------------------------------

model PlatformSettings {
  id                String   @id @default("singleton")
  platformNameAr    String   @default("أمبير")
  platformNameEn    String   @default("Ampere")
  companyName       String?
  copyright         String?
  supportEmail      String?
  supportPhone      String?
  websiteUrl        String?
  metaTitle         String?
  metaDescription   String?
  primaryColor      String   @default("#0EA5E9")
  secondaryColor    String?
  accentColor       String?
  successColor      String?
  warningColor      String?
  errorColor        String?
  arabicFont        String?  @default("IBM Plex Sans Arabic")
  englishFont       String?  @default("Inter")
  updatedAt         DateTime @updatedAt
}

model BrandAsset {
  id        String   @id @default(cuid())
  // @unique (وليس فقط فهرس): كل نوع أصل بصري (شعار رئيسي، أيقونة...) له
  // سجل واحد فقط دائمًا - رفع نسخة جديدة يستبدل القديمة عبر upsert بدل
  // تراكم سجلات قديمة يتيمة لا تُعرض أبدًا.
  type      BrandAssetType @unique
  url       String
  updatedAt DateTime @updatedAt
}

enum BrandAssetType {
  MAIN_LOGO
  SIDEBAR_LOGO
  SMALL_LOGO
  LOGIN_LOGO
  FAVICON
  PWA_ICON
  SPLASH_ICON
  SOCIAL_SHARE_IMAGE
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  imageUrl    String?
  buttonText  String?
  buttonUrl   String?
  priority    Int      @default(0)
  startDate   DateTime
  endDate     DateTime?
  visibility  Json     // { allTenants: bool, tenantIds: [], planIds: [] }
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model PushNotificationCampaign {
  id            String   @id @default(cuid())
  title         String
  message       String
  imageUrl      String?
  actionText    String?
  actionUrl     String?
  audience      Json     // { allUsers, tenantIds, planIds, roles }
  status        CampaignStatus @default(DRAFT)
  scheduledFor  DateTime?
  sentAt        DateTime?
  createdAt     DateTime @default(now())

  stats NotificationStat?
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  FAILED
}

model NotificationStat {
  id           String   @id @default(cuid())
  campaignId   String   @unique
  recipients   Int      @default(0)
  delivered    Int      @default(0)
  opened       Int      @default(0)
  failed       Int      @default(0)

  campaign PushNotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}
